{
  "name": "@trwhitney/component-library",
  "version": "0.0.0",
  "private": true,
  "description": "React components with a shared visual language and behavior model.",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./manifest.json": "./dist/manifest.json",
    "./agent-index.md": "./dist/agent-index.md"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "browserslist": [
    "baseline 2023"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:generated && npm run typecheck:matrix && npm run verify:chart-isolation && npm run verify:editor-isolation",
    "check:generated": "node ./scripts/build.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"**/*.css\" --max-warnings 0",
    "prepack": "npm run build",
    "prototype:analysis": "node ./scripts/data-analysis-prototype.mjs",
    "prototype:analysis:build": "node ./scripts/data-analysis-prototype.mjs --build",
    "showcase": "vite showcase",
    "showcase:build": "vite build showcase --outDir ../.showcase-dist --emptyOutDir",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:matrix": "npm run build && node ./scripts/typecheck-matrix.mjs",
    "verify:chart-performance": "node ./scripts/verify-chart-performance.mjs",
    "verify:chart-isolation": "npm run build && node ./scripts/verify-chart-isolation.mjs",
    "verify:package": "node ./scripts/verify-package.mjs",
    "verify:editor-isolation": "npm run build && node ./scripts/verify-editor-isolation.mjs",
    "prototype:markdown": "node ./scripts/markdown-authoring-prototype.mjs",
    "prototype:markdown:build": "node ./scripts/markdown-authoring-prototype.mjs --build",
    "prototype:workbench": "node ./scripts/application-workbench-prototype.mjs",
    "prototype:workbench:build": "node ./scripts/application-workbench-prototype.mjs --build"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@internationalized/date": "3.12.3",
    "@lezer/highlight": "1.2.3",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-hast": "13.2.1",
    "micromark-util-decode-string": "2.0.1",
    "micromark-util-types": "2.0.2",
    "react-aria": "3.51.0",
    "react-aria-components": "1.20.0",
    "react-markdown": "10.1.0",
    "react-stately": "3.49.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react": "16.3.2",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "27.0.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-6": "npm:typescript@6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
